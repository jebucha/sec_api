// Starter pack: credentials and keys. All rules mask excerpts (design D12).
{"id":"SE-001","name":"AWS access key id","version":"2","description":"AWS access key id (AKIA + 16 uppercase alphanumerics).","stage":"request","target":["user_text","tool_results"],"type":"regex","severity":"high","action":"block","enabled":true,"owasp":["LLM02: Sensitive Information Disclosure"],"atlas":["A21-014"],"tags":["secrets"],"mask_excerpt":true,"pattern":"\\bAKIA[0-9A-Z]{16}\\b","tests":{"match":["My aws key is AKIAIOSFODNN7EXAMPLE ok?"],"no_match":["The AKIA prefix marks AWS access key ids in the docs."]}}
{"id":"SE-002","name":"VCS and bot tokens","version":"2","description":"GitHub personal access tokens and Slack bot tokens.","stage":"request","target":["user_text","tool_results"],"type":"regex","severity":"high","action":"block","enabled":true,"owasp":["LLM02: Sensitive Information Disclosure"],"atlas":["A21-014"],"tags":["secrets"],"mask_excerpt":true,"pattern":"(?i)\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{16,}\\b|\\bgithub_pat_[A-Za-z0-9_]{16,}\\b|\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b","tests":{"match":["Push with ghp_abcdefghij1234567890abcdef as the token.","Use xoxb-1234567890-abcdefghijklmnop for the bot."],"no_match":["A GitHub personal access token starts with ghp_.","The docs describe the xoxb- prefix format."]}}
{"id":"SE-003","name":"private key header","version":"2","description":"PEM private key headers pasted into content.","stage":"request","target":["user_text","tool_results"],"type":"regex","severity":"critical","action":"block","enabled":true,"owasp":["LLM02: Sensitive Information Disclosure"],"atlas":["A21-014"],"tags":["secrets"],"mask_excerpt":true,"pattern":"-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----","tests":{"match":["-----BEGIN RSA PRIVATE KEY-----","-----BEGIN OPENSSH PRIVATE KEY-----","-----BEGIN PRIVATE KEY-----"],"no_match":["-----BEGIN CERTIFICATE-----","-----END PRIVATE KEY-----"]}}
{"id":"SE-004","name":"credential assignment","version":"2","description":"A quoted credential assigned to a key/token variable.","stage":"request","target":["user_text","tool_results"],"type":"regex","severity":"high","action":"block","enabled":true,"owasp":["LLM02: Sensitive Information Disclosure"],"atlas":["A21-014"],"tags":["secrets"],"mask_excerpt":true,"pattern":"(?i)\\b(?:api[_-]?key|auth[_-]?token|access[_-]?token)\\b\\s*[:=]\\s*['\\\"][A-Za-z0-9+/=_-]{16,}","tests":{"match":["config: api_key=\"sk-abcdefghijklmnopqrstuvwxyz123456\""],"no_match":["You can set your API key in the dashboard under settings.","The access token expires in 60 seconds."]}}
